@page "/chat"
@page "/chat/{SessionIdParam}"
@using CodePilot.Api.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<CodePilotDbContext> DbFactory
@inject NavigationManager Navigation

<div class="flex flex-col h-full">
    <div class="flex-1 overflow-auto p-6">
        <div class="max-w-4xl mx-auto space-y-4">
            
            @if (messages.Count == 0)
            {
                <div class="text-center py-12 space-y-4">
                    <h2 class="text-2xl font-semibold">Start a conversation</h2>
                    <p class="text-muted">Ask GitHub Copilot anything about your code</p>
                </div>
            }
            
            @foreach (var message in messages)
            {
                <div class="@(message.Role == "user" ? "flex justify-end" : "flex justify-start")">
                    <div class="@(message.Role == "user" ? "message-user" : "message-assistant")">
                        <div class="text-sm font-medium mb-1">
                            @(message.Role == "user" ? "You" : "GitHub Copilot")
                        </div>
                        <div class="whitespace-pre-wrap">
                            @message.Content
                        </div>
                    </div>
                </div>
            }
            
            @if (isStreaming)
            {
                <div class="flex justify-start">
                    <div class="message-assistant">
                        <div class="text-sm font-medium mb-1">GitHub Copilot</div>
                        <div class="flex items-center gap-2">
                            <span class="spinner"></span>
                            Thinking...
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    
    <div class="border-t p-4">
        <div class="max-w-4xl mx-auto">
            <div class="flex gap-2">
                <input type="text" 
                       class="input flex-1" 
                       @bind="currentInput"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyPress"
                       placeholder="Ask GitHub Copilot..."
                       disabled="@isStreaming" />
                <button class="btn btn-primary" 
                        @onclick="SendMessage" 
                        disabled="@(string.IsNullOrWhiteSpace(currentInput) || isStreaming)">
                    Send
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .message-user {
        background-color: var(--primary);
        color: var(--primary-foreground);
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        max-width: 80%;
    }

    .message-assistant {
        background-color: var(--card);
        color: var(--card-foreground);
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        max-width: 80%;
    }

    .justify-end {
        justify-content: flex-end;
    }

    .justify-start {
        justify-content: flex-start;
    }

    .whitespace-pre-wrap {
        white-space: pre-wrap;
    }
</style>

@code {
    [Parameter]
    public string? SessionIdParam { get; set; }

    private List<Message> messages = new();
    private string currentInput = "";
    private bool isStreaming = false;
    private string currentSessionId = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(SessionIdParam))
        {
            await LoadSession(SessionIdParam);
        }
        else
        {
            await CreateNewSession();
        }
    }

    private async Task LoadSession(string sessionId)
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            
            var session = await context.ChatSessions
                .FirstOrDefaultAsync(s => s.Id == sessionId);

            if (session != null)
            {
                currentSessionId = session.Id;
                messages = await context.Messages
                    .Where(m => m.SessionId == sessionId)
                    .OrderBy(m => m.CreatedAt)
                    .ToListAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading session: {ex.Message}");
        }
    }

    private async Task CreateNewSession()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            
            var session = new ChatSession
            {
                Id = Guid.NewGuid().ToString(),
                Title = "New Chat",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            context.ChatSessions.Add(session);
            await context.SaveChangesAsync();

            currentSessionId = session.Id;
            Navigation.NavigateTo($"/chat/{currentSessionId}", replace: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating session: {ex.Message}");
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentInput) || isStreaming)
            return;

        var userMessage = currentInput;
        currentInput = "";
        isStreaming = true;
        StateHasChanged();

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            
            // Save user message
            var message = new Message
            {
                Id = Guid.NewGuid().ToString(),
                SessionId = currentSessionId,
                Role = "user",
                Content = userMessage,
                CreatedAt = DateTime.UtcNow
            };

            context.Messages.Add(message);
            await context.SaveChangesAsync();
            messages.Add(message);
            StateHasChanged();

            // Simulate assistant response
            await Task.Delay(1000);
            
            var assistantMessage = new Message
            {
                Id = Guid.NewGuid().ToString(),
                SessionId = currentSessionId,
                Role = "assistant",
                Content = $"This is a simulated response to: {userMessage}\n\nIn production, this would stream from GitHub Copilot SDK.",
                CreatedAt = DateTime.UtcNow
            };

            context.Messages.Add(assistantMessage);
            
            // Update session
            var session = await context.ChatSessions.FindAsync(currentSessionId);
            if (session != null)
            {
                session.UpdatedAt = DateTime.UtcNow;
                if (session.Title == "New Chat" && messages.Count <= 2)
                {
                    session.Title = userMessage.Length > 50 ? userMessage.Substring(0, 47) + "..." : userMessage;
                }
            }

            await context.SaveChangesAsync();
            messages.Add(assistantMessage);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending message: {ex.Message}");
        }
        finally
        {
            isStreaming = false;
            StateHasChanged();
        }
    }
}
