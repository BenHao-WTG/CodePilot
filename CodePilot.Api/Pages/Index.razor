@page "/"
@using CodePilot.Api.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<CodePilotDbContext> DbFactory
@inject NavigationManager Navigation

<div class="flex h-full items-center justify-center p-8">
    <div class="w-full max-w-4xl space-y-8">
        
        <!-- Welcome Section -->
        <div class="text-center space-y-4">
            <h1 class="text-4xl font-bold tracking-tight">Welcome to CodePilot</h1>
            <p class="text-lg text-muted">
                Your desktop GUI for GitHub Copilot
            </p>
        </div>

        <!-- Connection Status -->
        @if (!loading)
        {
            <div class="card">
                <div class="card-header">
                    <div class="card-title flex items-center gap-2">
                        @if (copilotAvailable)
                        {
                            <span class="text-green-500">✓</span>
                        }
                        else
                        {
                            <span class="text-yellow-500">⚠</span>
                        }
                        GitHub Copilot Status
                    </div>
                </div>
                <div class="card-content">
                    @if (copilotAvailable)
                    {
                        <div class="space-y-2">
                            <p class="text-sm text-muted">
                                ✅ Connected and ready to use
                            </p>
                            @if (!string.IsNullOrEmpty(copilotModel))
                            {
                                <p class="text-sm text-muted">
                                    Model: @copilotModel
                                </p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            <p class="text-sm text-yellow-600">
                                ⚠️ GitHub Copilot is not connected
                            </p>
                            @if (!string.IsNullOrEmpty(copilotError))
                            {
                                <p class="text-sm text-muted">
                                    @copilotError
                                </p>
                            }
                            <button class="btn btn-outline btn-sm mt-2" @onclick="NavigateToSettings">
                                <span>⚙️</span>
                                Configure Settings
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Action Buttons -->
        <div class="grid gap-4 action-grid">
            <div class="card card-hover" @onclick="NavigateToNewChat">
                <div class="card-header">
                    <div class="card-title flex items-center gap-2">
                        <span>💬</span>
                        New Chat
                    </div>
                    <div class="card-description">
                        Start a new conversation with GitHub Copilot
                    </div>
                </div>
            </div>

            <div class="card card-hover" @onclick="NavigateToSettings">
                <div class="card-header">
                    <div class="card-title flex items-center gap-2">
                        <span>⚙️</span>
                        Settings
                    </div>
                    <div class="card-description">
                        Configure your GitHub token and preferences
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Sessions -->
        @if (recentSessions != null && recentSessions.Count > 0)
        {
            <div class="card">
                <div class="card-header">
                    <div class="card-title flex items-center gap-2">
                        <span>🔄</span>
                        Recent Sessions
                    </div>
                    <div class="card-description">
                        Continue where you left off
                    </div>
                </div>
                <div class="card-content">
                    <div class="space-y-2">
                        @foreach (var session in recentSessions)
                        {
                            <div class="flex items-center justify-between rounded-lg border p-3 cursor-pointer transition hover-accent"
                                 @onclick="() => NavigateToSession(session.Id)">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium truncate">
                                        @(session.Title ?? "Untitled Session")
                                    </p>
                                    <p class="text-xs text-muted">
                                        @session.UpdatedAt.ToLocalTime().ToString("g")
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Getting Started -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">Getting Started</div>
            </div>
            <div class="card-content space-y-2 text-sm text-muted">
                <p>📝 Click "New Chat" to start a conversation</p>
                <p>⚙️ Configure your GitHub token in Settings</p>
                <p>💡 Use the help button (top right) for documentation</p>
                <p>🎨 Toggle between light and dark mode as you prefer</p>
            </div>
        </div>

    </div>
</div>

<style>
    .tracking-tight {
        letter-spacing: -0.025em;
    }
    
    .min-w-0 {
        min-width: 0;
    }
    
    .flex-1 {
        flex: 1 1 0%;
    }
    
    .hover-accent:hover {
        background-color: var(--accent);
    }
    
    .action-grid {
        grid-template-columns: 1fr;
    }
    
    @@media (min-width: 768px) {
        .action-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

@code {
    private bool loading = true;
    private bool copilotAvailable = false;
    private string? copilotModel = null;
    private string? copilotError = null;
    private List<ChatSession> recentSessions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            // Load recent sessions
            await using var context = await DbFactory.CreateDbContextAsync();
            recentSessions = await context.ChatSessions
                .OrderByDescending(s => s.UpdatedAt)
                .Take(5)
                .ToListAsync();

            // Check Copilot status (simulated for now)
            // In production, this would call the CopilotService
            copilotAvailable = false;
            copilotError = "Not configured. Please set your GitHub token in Settings.";

            loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            loading = false;
            StateHasChanged();
        }
    }

    private void NavigateToNewChat()
    {
        Navigation.NavigateTo("/chat");
    }

    private void NavigateToSettings()
    {
        Navigation.NavigateTo("/settings");
    }

    private void NavigateToSession(string sessionId)
    {
        Navigation.NavigateTo($"/chat/{sessionId}");
    }
}
