@page "/plugins"

<div class="p-8">
    <div class="max-w-4xl mx-auto space-y-8">
        
        <!-- Header -->
        <div>
            <h1 class="text-3xl font-bold">Plugins</h1>
            <p class="text-muted mt-2">Manage MCP servers and skills</p>
        </div>

        <!-- MCP Servers -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">MCP Servers</div>
                <div class="card-description">
                    Model Context Protocol servers extend Copilot's capabilities
                </div>
            </div>
            <div class="card-content space-y-4">
                <div class="text-sm text-muted text-center py-8">
                    No MCP servers configured yet
                </div>
                <button class="btn btn-outline w-full">
                    + Add MCP Server
                </button>
            </div>
        </div>

        <!-- Skills -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">Skills</div>
                <div class="card-description">
                    Custom commands and workflows
                </div>
            </div>
            <div class="card-content space-y-4">
                <div class="text-sm text-muted text-center py-8">
                    No skills configured yet
                </div>
                <button class="btn btn-outline w-full">
                    + Create Skill
                </button>
            </div>
        </div>

    </div>
</div>
