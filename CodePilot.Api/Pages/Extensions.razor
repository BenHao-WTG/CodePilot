@page "/extensions"

<div class="extensions-page">
    <div class="page-header">
        <h1>Extensions</h1>
        <p>Extend CodePilot with additional features and integrations.</p>
    </div>
    
    <div class="content-grid">
        <div class="section">
            <h2>Available Extensions</h2>
            
            <div class="extension-list">
                <div class="extension-card">
                    <div class="extension-icon">🔧</div>
                    <div class="extension-info">
                        <h3>Code Review Assistant</h3>
                        <p>Get AI-powered code reviews and suggestions</p>
                        <span class="badge badge-success">Installed</span>
                    </div>
                </div>
                
                <div class="extension-card">
                    <div class="extension-icon">📝</div>
                    <div class="extension-info">
                        <h3>Documentation Generator</h3>
                        <p>Automatically generate documentation for your code</p>
                        <span class="badge badge-secondary">Available</span>
                    </div>
                </div>
                
                <div class="extension-card">
                    <div class="extension-icon">🧪</div>
                    <div class="extension-info">
                        <h3>Test Generator</h3>
                        <p>Create unit tests automatically</p>
                        <span class="badge badge-secondary">Available</span>
                    </div>
                </div>
                
                <div class="extension-card">
                    <div class="extension-icon">🔍</div>
                    <div class="extension-info">
                        <h3>Code Search</h3>
                        <p>Search across your entire codebase with AI</p>
                        <span class="badge badge-success">Installed</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="section">
            <h2>Community Extensions</h2>
            <div class="info-box">
                <p>Discover and install extensions created by the community.</p>
                <p>Extension marketplace coming soon!</p>
            </div>
        </div>
    </div>
</div>

@code {
    // Extensions page - placeholder for future functionality
}
