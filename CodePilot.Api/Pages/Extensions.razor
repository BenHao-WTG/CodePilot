@page "/extensions"

<div class="p-8">
    <div class="max-w-4xl mx-auto space-y-8">
        
        <!-- Header -->
        <div>
            <h1 class="text-3xl font-bold">Extensions</h1>
            <p class="text-muted mt-2">Explore community extensions and integrations</p>
        </div>

        <!-- Extensions Grid -->
        <div class="grid gap-4 md-grid-cols-2">
            
            <div class="card">
                <div class="card-header">
                    <div class="flex items-center justify-between">
                        <div class="card-title">File Explorer</div>
                        <span class="badge badge-success">Active</span>
                    </div>
                    <div class="card-description">
                        Browse and manage project files
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="flex items-center justify-between">
                        <div class="card-title">Terminal</div>
                        <span class="badge badge-secondary">Available</span>
                    </div>
                    <div class="card-description">
                        Execute commands directly
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="flex items-center justify-between">
                        <div class="card-title">Git Integration</div>
                        <span class="badge badge-secondary">Available</span>
                    </div>
                    <div class="card-description">
                        Version control operations
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="flex items-center justify-between">
                        <div class="card-title">Code Search</div>
                        <span class="badge badge-secondary">Available</span>
                    </div>
                    <div class="card-description">
                        Search across your codebase
                    </div>
                </div>
            </div>

        </div>

        <!-- Community Section -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">Community Extensions</div>
                <div class="card-description">
                    Coming soon: Discover and install community-created extensions
                </div>
            </div>
            <div class="card-content">
                <div class="text-sm text-muted text-center py-8">
                    Extension marketplace coming in a future update
                </div>
            </div>
        </div>

    </div>
</div>
