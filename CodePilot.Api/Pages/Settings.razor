@page "/settings"
@using CodePilot.Api.Data
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject IDbContextFactory<CodePilotDbContext> DbFactory
@inject IJSRuntime JSRuntime

<div class="p-8">
    <div class="max-w-2xl mx-auto space-y-8">
        
        <!-- Header -->
        <div>
            <h1 class="text-3xl font-bold">Settings</h1>
            <p class="text-muted mt-2">Configure your GitHub Copilot connection and preferences</p>
        </div>

        <!-- GitHub Copilot Authentication -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">GitHub Copilot Authentication</div>
                <div class="card-description">
                    Configure your GitHub personal access token to connect with GitHub Copilot
                </div>
            </div>
            <div class="card-content space-y-4">
                <div class="space-y-2">
                    <label class="text-sm font-medium">GitHub Token</label>
                    <div class="flex gap-2">
                        <input type="@(showToken ? "text" : "password")" 
                               class="input flex-1" 
                               @bind="githubToken"
                               placeholder="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                        <button class="btn btn-outline" @onclick="ToggleTokenVisibility">
                            @(showToken ? "🙈" : "👁️")
                        </button>
                    </div>
                    <p class="text-xs text-muted">
                        Get your token from 
                        <a href="https://github.com/settings/tokens" target="_blank" class="text-primary underline">
                            GitHub Settings
                        </a>
                    </p>
                </div>

                <button class="btn btn-primary" @onclick="SaveGitHubToken" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner"></span>
                    }
                    Save GitHub Token
                </button>

                @if (!string.IsNullOrEmpty(apiStatusMessage))
                {
                    <div class="@(apiStatusSuccess ? "text-green-500" : "text-red-500") text-sm">
                        @apiStatusMessage
                    </div>
                }
            </div>
        </div>

        <!-- Copilot CLI Settings -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">Copilot CLI Settings</div>
                <div class="card-description">
                    Advanced configuration for Copilot CLI behavior
                </div>
            </div>
            <div class="card-content">
                <!-- Tabs -->
                <div class="tabs">
                    <div class="flex gap-2 border-b">
                        <button class="@(activeTab == "form" ? "tab-active" : "tab")" 
                                @onclick='() => activeTab = "form"'>
                            Visual Editor
                        </button>
                        <button class="@(activeTab == "json" ? "tab-active" : "tab")" 
                                @onclick='() => activeTab = "json"'>
                            JSON Editor
                        </button>
                    </div>

                    <div class="mt-4">
                        @if (activeTab == "form")
                        {
                            <div class="space-y-4">
                                <div class="space-y-2">
                                    <label class="text-sm font-medium">Permissions</label>
                                    <textarea class="input textarea" 
                                              @bind="permissionsText" 
                                              rows="4"
                                              placeholder='{"read": ["files"], "write": []}'></textarea>
                                </div>
                                <div class="space-y-2">
                                    <label class="text-sm font-medium">Environment Variables</label>
                                    <textarea class="input textarea" 
                                              @bind="environmentText" 
                                              rows="4"
                                              placeholder='{"KEY": "value"}'></textarea>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-2">
                                <textarea class="input textarea" 
                                          @bind="fullJsonText" 
                                          rows="12"
                                          style="font-family: monospace; font-size: 0.875rem;"></textarea>
                            </div>
                        }
                    </div>
                </div>

                <div class="flex gap-2 mt-4">
                    <button class="btn btn-primary" @onclick='() => SaveSettings("form")' disabled="@isSavingCli">
                        @if (isSavingCli)
                        {
                            <span class="spinner"></span>
                        }
                        Save
                    </button>
                    <button class="btn btn-outline" @onclick="ResetSettings">
                        Reset
                    </button>
                    @if (activeTab == "json")
                    {
                        <button class="btn btn-secondary" @onclick="FormatJson">
                            Format
                        </button>
                    }
                </div>

                @if (!string.IsNullOrEmpty(cliStatusMessage))
                {
                    <div class="@(cliStatusSuccess ? "text-green-500" : "text-red-500") text-sm mt-4">
                        @cliStatusMessage
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<style>
    .mx-auto {
        margin-left: auto;
        margin-right: auto;
    }

    .tab {
        padding: 0.5rem 1rem;
        border-bottom: 2px solid transparent;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--muted-foreground);
        background: transparent;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .tab:hover {
        color: var(--foreground);
    }

    .tab-active {
        padding: 0.5rem 1rem;
        border-bottom: 2px solid var(--primary);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--primary);
        background: transparent;
        cursor: pointer;
    }

    .underline {
        text-decoration: underline;
    }

    .spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spin 0.75s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private string activeTab = "form";
    private string githubToken = "";
    private bool showToken = false;
    private bool isSaving = false;
    private bool isSavingCli = false;
    private string? apiStatusMessage;
    private bool apiStatusSuccess;
    private string? cliStatusMessage;
    private bool cliStatusSuccess;

    private string permissionsText = "{}";
    private string environmentText = "{}";
    private string fullJsonText = "{}";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            
            var tokenSetting = await context.Settings.FirstOrDefaultAsync(s => s.Key == "github_token");
            if (tokenSetting != null && !string.IsNullOrEmpty(tokenSetting.Value))
            {
                githubToken = new string('*', 40); // Masked
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading settings: {ex.Message}");
        }
    }

    private void ToggleTokenVisibility()
    {
        showToken = !showToken;
    }

    private async Task SaveGitHubToken()
    {
        isSaving = true;
        apiStatusMessage = null;
        StateHasChanged();

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            
            var setting = await context.Settings.FirstOrDefaultAsync(s => s.Key == "github_token");
            if (setting == null)
            {
                setting = new Setting { Key = "github_token", Value = githubToken };
                context.Settings.Add(setting);
            }
            else
            {
                setting.Value = githubToken;
            }

            await context.SaveChangesAsync();

            apiStatusMessage = "✅ GitHub token saved successfully!";
            apiStatusSuccess = true;

            // Mask the token after saving
            await Task.Delay(1500);
            githubToken = new string('*', 40);
        }
        catch (Exception ex)
        {
            apiStatusMessage = $"❌ Error: {ex.Message}";
            apiStatusSuccess = false;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task SaveSettings(string source)
    {
        isSavingCli = true;
        cliStatusMessage = null;
        StateHasChanged();

        try
        {
            // In a real implementation, this would save CLI settings
            await Task.Delay(500);
            cliStatusMessage = "✅ Settings saved successfully!";
            cliStatusSuccess = true;
        }
        catch (Exception ex)
        {
            cliStatusMessage = $"❌ Error: {ex.Message}";
            cliStatusSuccess = false;
        }
        finally
        {
            isSavingCli = false;
            StateHasChanged();
        }
    }

    private void ResetSettings()
    {
        permissionsText = "{}";
        environmentText = "{}";
        fullJsonText = "{}";
        cliStatusMessage = "Settings reset to defaults";
        cliStatusSuccess = true;
        StateHasChanged();
    }

    private void FormatJson()
    {
        try
        {
            var obj = JsonDocument.Parse(fullJsonText);
            fullJsonText = JsonSerializer.Serialize(obj, new JsonSerializerOptions { WriteIndented = true });
            StateHasChanged();
        }
        catch
        {
            cliStatusMessage = "❌ Invalid JSON";
            cliStatusSuccess = false;
            StateHasChanged();
        }
    }
}
